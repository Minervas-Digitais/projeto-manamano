# =====================================================================
# ManaMano — variáveis de ambiente (arquivo único do projeto)
#
#   cp .env.example .env
#
# Lido por: docker-compose (raiz), backend (backend/src/load-env.ts)
# e frontend/Expo (frontend/metro.config.js). Nenhum outro .env existe.
#
# Em docker o compose sobrescreve DATABASE_URL para o host
# `postgres_db`; o valor abaixo vale para rodar fora do docker.
# =====================================================================

# ---------- PostgreSQL (docker-compose) ----------
# Credenciais do banco criado pelo container manamano-db.
# POSTGRES_DB precisa ser igual ao nome dentro de DATABASE_URL.
POSTGRES_USER="username"
POSTGRES_PASSWORD="password"
POSTGRES_DB="manamanodb"
POSTGRES_PORT="5432"

# ---------- Modo Docker ----------
# development → entrypoint: prisma migrate dev + start:dev (watch)
# production  → entrypoint: prisma migrate deploy + start:prod
APP_ENV="development"
# Estágio do backend/Dockerfile: runtime-dev ou runtime-prod
DOCKER_TARGET="runtime-dev"

# ---------- Backend ----------
BACKEND_PORT="3000"
# Conexão com o banco no host (fora do docker).
# Os ${...} são expandidos automaticamente (prisma.config.ts + backend) —
# o nome do banco vem de POSTGRES_DB, não repita valores aqui.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# --- Autenticação JWT ---
# Gere valores longos e aleatórios, ex.: openssl rand -hex 32
JWT_SECRET=""
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# --- E-mail (SMTP) ---
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "yes" liga TLS no envio (smtp.gmail.com:465 usa TLS; 587 costuma ficar vazio)
SMTP_TLS=""

# ---------- Frontend (Expo) ----------
# URL da API embutida no bundle do app no momento do build.
# Só aceita valores com o prefixo EXPO_PUBLIC_.
# Dev: IP da máquina host (o emulador não enxerga "localhost").
# Prod: URL pública da API.
EXPO_PUBLIC_API_URL="http://localhost:3000"
