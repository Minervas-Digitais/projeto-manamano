    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "android.frontend"
    },
    "web": {},
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "bc157627-f7ac-4034-8e10-04bb7dd02292"
      }
    },
    "owner": "manamano"
  }
}
